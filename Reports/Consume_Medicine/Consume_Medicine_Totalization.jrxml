	<style name="Style1" backcolor="#F4F5F6" fill="Solid"/>
	<parameter name="Username" class="java.lang.String"/>
	<parameter name="StartDate" class="java.util.Date"/>
	<parameter name="EndDate" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT 
"Medicine.Name" AS Name,
SUM("Medicine.Dosage") AS TotalDosage
FROM MedicineConsume_Log
WHERE Username =$P{Username} 
AND Action <> 'Agendado'
AND Action <> 'Solicitado'
AND  LogAt BETWEEN $P{StartDate} AND $P{EndDate}
GROUP BY Name]]>
	</queryString>
